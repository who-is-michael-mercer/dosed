{
  "name": "dosed",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate": "node --import tsx scripts/generate-content.mjs",
    "validate:content": "node --import tsx scripts/validate-content.mjs",
    "check:generated": "node --import tsx scripts/check-generated.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --import tsx --test tests/*.test.mjs",
    "test:components": "jest --runInBand",
    "build:smoke": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.0",
    "expo-linking": "~57.0.9",
    "expo-constants": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.6.2",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  }
}
