{
  "name": "dosed",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate": "node --import tsx scripts/generate-content.mjs",
    "validate:content": "node --import tsx scripts/validate-content.mjs",
    "check:generated": "node --import tsx scripts/check-generated.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build:smoke": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.21",
    "expo-linking": "8.0.8",
    "expo-router": "6.0.14",
    "expo-status-bar": "3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-web": "^0.21.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "19.1.16",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.6.2",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22"
  }
}
